// Keep the primary action visible. All secondary actions live in the same
// compact dropdown on desktop and mobile.
document.querySelectorAll('details.relative').forEach(dropdown => {
  const menu = dropdown.querySelector(':scope > div.absolute');
  const container = dropdown.parentElement;
  if (!menu || !container) return;

  const viewButton = container.querySelector(':scope > button[onclick^="viewRotation("]');
  if (viewButton) {
    viewButton.className = 'w-full px-3 py-2 text-left text-xs rounded text-gray-200 hover:bg-gray-700';
    menu.insertBefore(viewButton, menu.firstChild);
  }

  const primaryButton = menu.querySelector('button[onclick^="rotationAction("]');
  if (primaryButton) {
    const isStop = primaryButton.getAttribute('onclick').includes("'stop'");
    primaryButton.className = container.tagName === 'TD'
      ? `px-3 py-1.5 text-xs rounded text-white ${isStop ? 'bg-red-500 hover:bg-red-600' : 'bg-primary hover:bg-blue-600'}`
      : `flex-1 py-2 text-xs rounded text-white ${isStop ? 'bg-red-500 hover:bg-red-600' : 'bg-primary hover:bg-blue-600'}`;
    primaryButton.textContent = isStop ? 'Stop' : 'Start';
    container.insertBefore(primaryButton, dropdown);
  }

  const editButton = menu.querySelector('button[onclick^="editRotation("]');
  if (editButton && !menu.querySelector('[data-rebuild-menu]')) {
    const match = editButton.getAttribute('onclick').match(/editRotation\('([^']+)'\)/);
    if (match) {
      const rebuildButton = document.createElement('button');
      rebuildButton.type = 'button';
      rebuildButton.dataset.rebuildMenu = match[1];
      rebuildButton.className = 'w-full px-3 py-2 text-left text-xs rounded text-amber-300 hover:bg-amber-500/15';
      rebuildButton.innerHTML = '<i class="ti ti-video mr-2"></i>Rebuild 4000';
      rebuildButton.onclick = () => rebuildReadyMedia(match[1]);
      editButton.insertAdjacentElement('afterend', rebuildButton);
    }
  }
});

// Native <details> does not close when the user clicks elsewhere. Make these
// action menus behave like a regular dropdown without affecting other details.
document.addEventListener('click', event => {
  document.querySelectorAll('details.relative[open]').forEach(dropdown => {
    if (!dropdown.contains(event.target)) dropdown.removeAttribute('open');
  });
});
document.querySelectorAll('details.relative').forEach(dropdown => {
  dropdown.addEventListener('click', event => {
    if (event.target.closest('.absolute button')) dropdown.removeAttribute('open');
  });
});
</script>
