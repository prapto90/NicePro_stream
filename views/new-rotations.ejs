// Weekly schedules can have multiple independent day/time windows.
function renderWeeklySlots() {
  const box = document.getElementById('repeatDays');
  if (!box) return;
  const names = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  if (!weeklySlots.length) weeklySlots = [{ day_of_week: 1, start_time: '00:00', end_time: '01:00' }];
  box.innerHTML = `<div class="flex items-center justify-between gap-3 mb-3"><div><span class="text-sm block">Weekly Live Slots</span><span class="text-xs text-gray-500">Each slot has its own day and live time (24-hour format).</span></div><button type="button" id="addWeeklySlot" class="text-xs px-3 py-1.5 bg-primary hover:bg-blue-600 rounded text-white"><i class="ti ti-plus"></i> Add Time</button></div><div class="space-y-2">${weeklySlots.map((slot, index) => `<div class="grid grid-cols-[1fr_90px_90px_auto] gap-2 items-end bg-dark-700 border border-gray-600 rounded-lg p-3"><label class="text-xs text-gray-400">Day<select data-slot-day="${index}" class="input mt-1">${names.map((name, day) => `<option value="${day}" ${Number(slot.day_of_week) === day ? 'selected' : ''}>${name}</option>`).join('')}</select></label><label class="text-xs text-gray-400">Start<input data-slot-start="${index}" type="text" inputmode="numeric" pattern="[0-2][0-9]:[0-5][0-9]" placeholder="HH:MM" value="${slot.start_time}" class="input mt-1"></label><label class="text-xs text-gray-400">End<input data-slot-end="${index}" type="text" inputmode="numeric" pattern="[0-2][0-9]:[0-5][0-9]" placeholder="HH:MM" value="${slot.end_time}" class="input mt-1"></label><button type="button" data-remove-slot="${index}" class="h-10 px-2 text-red-300 hover:text-red-100 ${weeklySlots.length === 1 ? 'opacity-30 pointer-events-none' : ''}" title="Remove time"><i class="ti ti-trash"></i></button></div>`).join('')}</div>`;
  document.getElementById('addWeeklySlot').onclick = () => { weeklySlots.push({ day_of_week: 1, start_time: '00:00', end_time: '01:00' }); renderWeeklySlots(); };
  box.querySelectorAll('[data-slot-day]').forEach(input => input.onchange = () => { weeklySlots[Number(input.dataset.slotDay)].day_of_week = Number(input.value); });
  box.querySelectorAll('[data-slot-start]').forEach(input => input.onchange = () => { weeklySlots[Number(input.dataset.slotStart)].start_time = input.value; });
  box.querySelectorAll('[data-slot-end]').forEach(input => input.onchange = () => { weeklySlots[Number(input.dataset.slotEnd)].end_time = input.value; });
  box.querySelectorAll('[data-remove-slot]').forEach(button => button.onclick = () => { weeklySlots.splice(Number(button.dataset.removeSlot), 1); renderWeeklySlots(); });
}
function enforce24HourTimeInputs() {
  document.querySelectorAll('#newRotationForm input[type="time"]').forEach(input => {
    input.type = 'text'; input.inputMode = 'numeric'; input.placeholder = 'HH:MM';
    input.pattern = '[0-2][0-9]:[0-5][0-9]'; input.title = 'Use 24-hour time, for example 20:30';
  });
}
function toggleRepeatDays() {
  const weekly = document.getElementById('repeatMode').value === 'weekly';
  const box = document.getElementById('repeatDays');
  const start = document.getElementById('rotationStartTime');
  const end = document.getElementById('rotationEndTime');
  const timeGrid = start?.closest('.grid');
  box.classList.toggle('hidden', !weekly);
  if (timeGrid) timeGrid.classList.toggle('hidden', weekly);
  if (start) start.required = !weekly;
  if (end) end.required = !weekly;
  if (weekly) renderWeeklySlots();
}
const originalOpenRotationModal = openRotationModal;
openRotationModal = function() { weeklySlots = []; originalOpenRotationModal(); enforce24HourTimeInputs(); toggleRepeatDays(); };
const originalEditRotation = editRotation;
editRotation = async function(id) {
  await originalEditRotation(id);
  enforce24HourTimeInputs();
  const { rotation } = await api(`/api/new-rotations/${id}`);
  if (rotation.repeat_mode === 'weekly') {
    weeklySlots = (rotation.schedule_slots || []).map(slot => ({ day_of_week: Number(slot.day_of_week), start_time: slot.start_time, end_time: slot.end_time }));
    if (!weeklySlots.length) weeklySlots = String(rotation.repeat_days || '').split(',').map(Number).filter(Number.isInteger).map(day => ({ day_of_week: day, start_time: (rotation.start_time || '').slice(11, 16), end_time: (rotation.end_time || '').slice(11, 16) }));
    toggleRepeatDays();
  }
};
enforce24HourTimeInputs();
document.getElementById('newRotationForm')?.addEventListener('submit', async event => {
  event.preventDefault(); event.stopImmediatePropagation();
  const form = new FormData(event.target); const payload = Object.fromEntries(form.entries());
  payload.thumbnail_video_ids = selectedThumbnailIds;
  payload.schedule_slots = document.getElementById('repeatMode').value === 'weekly' ? weeklySlots : [];
  payload.repeat_days = payload.schedule_slots.length ? [...new Set(payload.schedule_slots.map(slot => String(slot.day_of_week)))] : [];
  payload.youtube_monetization = form.get('youtube_monetization') === 'true';
  payload.disable_used_titles = form.get('disable_used_titles') === 'true';
  payload.disable_used_thumbnails = form.get('disable_used_thumbnails') === 'true';
  try { await api(editingRotationId ? `/api/new-rotations/${editingRotationId}` : '/api/new-rotations', { method: editingRotationId ? 'PUT' : 'POST', body: JSON.stringify(payload) }); location.reload(); } catch (error) { alert(error.message); }
}, true);
const originalViewRotation = viewRotation;
viewRotation = async function(id) {
  await originalViewRotation(id);
  const { rotation } = await api(`/api/new-rotations/${id}`);
  if (!rotation.schedule_slots?.length) return;
  const names = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const slots = rotation.schedule_slots.map(slot => `<span class="inline-flex items-center px-2.5 py-1 rounded bg-primary/15 text-primary text-xs">${names[Number(slot.day_of_week)]} ${escapeHtml(slot.start_time)}–${escapeHtml(slot.end_time)}</span>`).join(' ');
  document.getElementById('rotationViewContent').insertAdjacentHTML('beforeend', `<div class="mt-4"><div class="text-xs text-gray-400 mb-2">Weekly Live Slots</div><div class="flex flex-wrap gap-2">${slots}</div></div>`);
};

