<% layout('layout') -%>
<% const formatRotationTime = value => value && value.includes('T') ? value.split('T')[1].slice(0, 5) : '--';
const repeatLabel = rotation => {
  if (rotation.repeat_mode === 'weekly') {
    const names = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const days = String(rotation.repeat_days || '').split(',').map(Number).filter(Number.isInteger).map(day => names[day]).filter(Boolean);
    return `Every Week${days.length ? ` · ${days.join(', ')}` : ''}`;
  }
  return rotation.repeat_mode === 'monthly' ? 'Every Month' : 'Every Day';
}; %>

<div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
  <div>
    <h2 class="text-2xl font-bold">New Rotations</h2>
    <p class="text-gray-400 text-sm mt-1">Media is automatically prepared at 720p / 30 FPS / 4000 Kbps when a New Rotation is created.</p>
  </div>
  <% if (youtubeConnected) { %>
  <div class="flex gap-2 w-full md:w-auto">
    <a href="/new-rotation-title-warehouse" class="flex-1 md:flex-none inline-flex justify-center items-center gap-2 px-4 py-2 rounded-lg bg-gray-700 hover:bg-gray-600 text-white transition-colors"><i class="ti ti-folder"></i>Title Warehouse</a>
    <button onclick="openRotationModal()" class="flex-1 md:flex-none inline-flex justify-center items-center gap-2 px-4 py-2 rounded-lg bg-primary hover:bg-blue-600 text-white transition-colors"><i class="ti ti-plus"></i>New Rotation</button>
  </div>
  <% } %>
</div>

<% if (!youtubeConnected) { %>
<div class="bg-yellow-900/20 border border-yellow-600/30 rounded-lg p-6"><div class="flex items-center gap-4"><i class="ti ti-brand-youtube text-yellow-400 text-3xl"></i><div><h3 class="font-medium text-yellow-200">YouTube Connection Required</h3><a href="/settings?activeTab=integration" class="text-sm text-yellow-400 hover:underline">Connect a YouTube channel in Settings</a></div></div></div>
<% } else { %>
<div class="bg-blue-900/20 border border-blue-600/30 rounded-lg p-4 mb-6 flex gap-3 text-sm text-blue-100"><i class="ti ti-info-circle text-xl text-blue-400"></i><p><strong>How it works:</strong> select one video or playlist and your fixed description/tags. On every next daily slot, only the title from the warehouse and thumbnail from Gallery change.</p></div>
<% const preparingRotations = rotations.filter(rotation => ['pending', 'processing'].includes(rotation.preparation_status)); const readyRotations = rotations.filter(rotation => rotation.preparation_status === 'ready'); const failedRotations = rotations.filter(rotation => rotation.preparation_status === 'failed'); %>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
  <div class="bg-gray-800 border border-gray-700 rounded-lg p-3"><div class="text-xs text-gray-400">Preparing Media</div><div class="text-lg text-yellow-400 font-semibold"><%= preparingRotations.length %></div><div class="text-xs text-gray-500 truncate"><%= preparingRotations.map(rotation => rotation.name).join(', ') || 'None' %></div></div>
  <div class="bg-gray-800 border border-gray-700 rounded-lg p-3"><div class="text-xs text-gray-400">Ready to Start</div><div class="text-lg text-green-400 font-semibold"><%= readyRotations.length %></div><div class="text-xs text-gray-500 truncate"><%= readyRotations.map(rotation => rotation.name).join(', ') || 'None' %></div></div>
  <div class="bg-gray-800 border border-gray-700 rounded-lg p-3"><div class="text-xs text-gray-400">Preparation Failed</div><div class="text-lg text-red-400 font-semibold"><%= failedRotations.length %></div><div class="text-xs text-gray-500 truncate"><%= failedRotations.map(rotation => rotation.name).join(', ') || 'None' %></div></div>
</div>

<% if (rotations.length) { %>
<div class="hidden md:block bg-gray-800 rounded-lg shadow-md overflow-hidden">
  <div class="overflow-x-auto"><table class="min-w-full divide-y divide-gray-700"><thead class="bg-dark-700"><tr><th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase">Rotation</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase">Current Item</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase">Schedule</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase">Repeat</th><th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase">Status</th><th class="px-6 py-3 text-right text-xs font-medium text-gray-300 uppercase">Actions</th></tr></thead>
  <tbody class="divide-y divide-gray-700"><% rotations.forEach(rotation => { const itemNumber = Number(rotation.current_title_index || 0) + 1; %><tr class="hover:bg-dark-700/50"><td class="px-6 py-4"><div class="font-medium text-white"><%= rotation.name %></div><div class="text-xs text-gray-400 mt-1"><%= rotation.youtube_channel_name || 'Default YouTube channel' %> · <%= rotation.thumbnail_count %> thumbnails</div></td><td class="px-6 py-4"><div class="text-sm text-gray-200">Title <%= itemNumber %>/<%= rotation.title_count || 0 %></div><div class="text-xs text-gray-500"><%= rotation.live_count || 0 %> kali live</div></td><td class="px-6 py-4 text-sm"><span class="text-yellow-500"><%= formatRotationTime(rotation.start_time) %></span><span class="text-gray-500 px-1">→</span><span class="text-green-500"><%= formatRotationTime(rotation.end_time) %></span></td><td class="px-6 py-4 text-xs text-blue-300"><%= repeatLabel(rotation) %></td><td class="px-6 py-4"><span class="inline-flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full <%= rotation.status === 'active' ? 'bg-green-500/15 text-green-400' : 'bg-gray-700 text-gray-300' %>"><span class="w-1.5 h-1.5 rounded-full <%= rotation.status === 'active' ? 'bg-green-400 animate-pulse' : 'bg-gray-400' %>"></span><%= rotation.status === 'active' ? 'Active' : 'Inactive' %></span></td><td class="px-6 py-4 text-right whitespace-nowrap"><button onclick="viewRotation('<%= rotation.id %>')" class="px-2.5 py-1.5 text-xs rounded border border-gray-600 text-gray-200 hover:bg-gray-700"><i class="ti ti-eye"></i> View</button><details class="relative inline-block ml-2 text-left"><summary class="list-none cursor-pointer px-2.5 py-1.5 text-xs rounded border border-gray-600 text-gray-300 hover:bg-gray-700"><i class="ti ti-dots-vertical"></i></summary><div class="absolute right-0 z-40 mt-1 w-44 rounded-lg border border-gray-600 bg-gray-800 p-1 shadow-xl"><% if (rotation.status === 'active') { %><button onclick="rotationAction('<%= rotation.id %>', 'stop')" class="w-full px-3 py-2 text-left text-xs rounded text-red-300 hover:bg-red-500/15"><i class="ti ti-player-stop mr-2"></i>Stop Rotation</button><% } else { %><button onclick="rotationAction('<%= rotation.id %>', 'activate')" class="w-full px-3 py-2 text-left text-xs rounded text-green-300 hover:bg-green-500/15"><i class="ti ti-player-play mr-2"></i>Start Rotation</button><button onclick="editRotation('<%= rotation.id %>')" class="w-full px-3 py-2 text-left text-xs rounded text-gray-200 hover:bg-gray-700"><i class="ti ti-edit mr-2"></i>Edit</button><% if (rotation.preparation_status === 'needs_sync') { %><button onclick="syncMedia('<%= rotation.id %>')" class="w-full px-3 py-2 text-left text-xs rounded text-blue-300 hover:bg-blue-500/15"><i class="ti ti-refresh mr-2"></i>Sync / Refresh Media</button><% } %><% } %><button onclick="deleteRotation('<%= rotation.id %>')" class="w-full px-3 py-2 text-left text-xs rounded text-red-300 hover:bg-red-500/15"><i class="ti ti-trash mr-2"></i>Delete</button></div></details></td></tr><% }) %></tbody></table></div>
</div>
<div class="md:hidden space-y-3"><% rotations.forEach(rotation => { const itemNumber = Number(rotation.current_title_index || 0) + 1; %><div class="bg-gray-800 rounded-lg border border-gray-700 p-4"><div class="flex justify-between gap-3"><div><h3 class="font-medium"><%= rotation.name %></h3><p class="text-xs text-gray-400 mt-1">Title <%= itemNumber %>/<%= rotation.title_count || 0 %> · <%= rotation.live_count || 0 %> kali live</p></div><span class="text-xs h-fit px-2 py-1 rounded <%= rotation.status === 'active' ? 'bg-green-500/15 text-green-400' : 'bg-gray-700' %>"><%= rotation.status %></span></div><p class="text-xs text-gray-500 mt-3"><span class="text-yellow-500"><%= formatRotationTime(rotation.start_time) %></span> → <span class="text-green-500"><%= formatRotationTime(rotation.end_time) %></span> · <span class="text-blue-300"><%= repeatLabel(rotation) %></span></p><div class="mt-4 flex gap-2"><button onclick="viewRotation('<%= rotation.id %>')" class="flex-1 py-2 text-xs border border-gray-600 rounded text-gray-200"><i class="ti ti-eye"></i> View</button><details class="relative"><summary class="list-none cursor-pointer px-3 py-2 text-xs border border-gray-600 rounded text-gray-300"><i class="ti ti-dots-vertical"></i></summary><div class="absolute right-0 z-40 mt-1 w-48 rounded-lg border border-gray-600 bg-gray-800 p-1 shadow-xl"><% if (rotation.status === 'active') { %><button onclick="rotationAction('<%= rotation.id %>', 'stop')" class="w-full px-3 py-2 text-left text-xs rounded text-red-300 hover:bg-red-500/15"><i class="ti ti-player-stop mr-2"></i>Stop Rotation</button><% } else { %><button onclick="rotationAction('<%= rotation.id %>', 'activate')" class="w-full px-3 py-2 text-left text-xs rounded text-green-300 hover:bg-green-500/15"><i class="ti ti-player-play mr-2"></i>Start Rotation</button><button onclick="editRotation('<%= rotation.id %>')" class="w-full px-3 py-2 text-left text-xs rounded text-gray-200 hover:bg-gray-700"><i class="ti ti-edit mr-2"></i>Edit</button><% if (rotation.preparation_status === 'needs_sync') { %><button onclick="syncMedia('<%= rotation.id %>')" class="w-full px-3 py-2 text-left text-xs rounded text-blue-300 hover:bg-blue-500/15"><i class="ti ti-refresh mr-2"></i>Sync / Refresh Media</button><% } %><% } %><button onclick="deleteRotation('<%= rotation.id %>')" class="w-full px-3 py-2 text-left text-xs rounded text-red-300 hover:bg-red-500/15"><i class="ti ti-trash mr-2"></i>Delete</button></div></details></div></div><% }) %></div>
<% } else { %>
<div class="bg-gray-800 rounded-lg border border-gray-700 p-10 text-center"><div class="w-14 h-14 mx-auto rounded-full bg-primary/15 text-primary flex items-center justify-center"><i class="ti ti-repeat text-3xl"></i></div><h3 class="mt-4 font-medium">No New Rotations Yet</h3><p class="mt-1 text-sm text-gray-400">Create a title warehouse, then create your first daily rotation.</p><button onclick="openWarehouseModal()" class="mt-4 text-sm text-primary hover:underline">Open Title Warehouse</button></div>
<% } %>
<% } %>

<div id="warehouseModal" class="hidden fixed inset-0 z-50 bg-black/70 p-4 overflow-y-auto"><div class="bg-gray-800 max-w-2xl mx-auto my-8 rounded-xl border border-gray-700 shadow-2xl"><div class="flex justify-between items-center p-5 border-b border-gray-700"><div><h3 class="font-semibold text-lg">Title Warehouse</h3><p class="text-xs text-gray-400 mt-1">Organize titles by category/channel.</p></div><button onclick="closeModal('warehouseModal')" class="text-gray-400 hover:text-white"><i class="ti ti-x text-xl"></i></button></div><div class="p-5"><button onclick="createCategory()" class="w-full mb-4 py-2 border border-dashed border-primary text-primary rounded-lg hover:bg-primary/10"><i class="ti ti-plus"></i> Add Category</button><div class="space-y-3"><% titleCategories.forEach(category => { %><div class="border border-gray-700 rounded-lg p-4"><div class="flex justify-between items-center"><div><div class="font-medium"><%= category.name %></div><div class="text-xs text-gray-400"><%= category.titles.length %> titles</div></div><button onclick="deleteCategory('<%= category.id %>')" class="text-xs text-red-400 hover:text-red-300">Delete category</button></div><div class="mt-3 space-y-1 max-h-40 overflow-y-auto"><% category.titles.forEach(title => { %><div class="flex justify-between gap-3 bg-dark-700 px-3 py-2 rounded text-xs"><span><%= title.title %></span><button onclick="deleteTitle('<%= title.id %>')" class="text-gray-500 hover:text-red-400">×</button></div><% }) %><% if (!category.titles.length) { %><p class="text-xs text-yellow-400">No titles yet</p><% } %></div><div class="mt-3"><textarea id="bulkTitles-<%= category.id %>" rows="3" class="input" placeholder="Love Afrika&#10;Relaxing Afrika&#10;Romantis Afrika"></textarea><div class="flex items-center justify-between mt-2"><span class="text-xs text-gray-500">Separate each title with a new line or comma.</span><button onclick="addTitles('<%= category.id %>')" class="text-xs px-3 py-1.5 bg-primary hover:bg-blue-600 rounded text-white">Add Titles</button></div></div></div><% }) %><% if (!titleCategories.length) { %><p class="text-center text-gray-500 text-sm py-6">No title categories yet.</p><% } %></div></div></div></div>

<div id="rotationModal" class="hidden fixed inset-0 z-50 bg-black/70 p-4 overflow-y-auto"><div class="bg-gray-800 max-w-3xl mx-auto my-8 rounded-xl border border-gray-700 shadow-2xl"><form id="newRotationForm"><div class="flex justify-between items-center p-5 border-b border-gray-700"><div><h3 id="rotationModalTitle" class="font-semibold text-lg">Create New Rotation</h3><p class="text-xs text-gray-400 mt-1">Fixed stream settings, rotating daily title and thumbnail.</p></div><button type="button" onclick="closeModal('rotationModal')" class="text-gray-400 hover:text-white"><i class="ti ti-x text-xl"></i></button></div><div class="p-5 space-y-4">
  <div class="grid md:grid-cols-2 gap-4"><label class="text-sm">Rotation Name<input required name="name" class="input" placeholder="e.g. Baladas Daily"></label><label class="text-sm">YouTube Channel<select name="youtube_channel_id" onchange="loadYouTubePlaylists(this.value)" class="input"><option value="">Default channel</option><% youtubeChannels.forEach(channel => { %><option value="<%= channel.id %>"><%= channel.channel_name %></option><% }) %></select></label></div>
  <label class="text-sm block">Add completed live to YouTube Playlist<select name="youtube_playlist_id" id="youtubePlaylistSelect" class="input"><option value="">Do not add to a playlist</option></select><span class="text-xs text-gray-500">Completed live recording is added automatically after the broadcast ends.</span></label>
  <div class="grid md:grid-cols-2 gap-4"><div class="relative"><label class="text-sm block">Source Video / Playlist</label><button type="button" onclick="toggleSourceSelector()" class="input flex justify-between items-center text-left"><span id="selectedSourceText" class="text-gray-400">Choose a playlist or video...</span><i class="ti ti-chevron-down text-gray-400"></i></button><input required type="hidden" name="video_id" id="sourceVideoId"><div id="sourceSelector" class="hidden absolute z-30 mt-2 w-full bg-dark-700 border border-gray-600 rounded-lg shadow-xl"><div class="p-2 border-b border-gray-600"><div class="relative"><i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i><input id="sourceSearch" oninput="renderSourceList(this.value)" class="w-full bg-dark-800 border border-gray-700 rounded-lg pl-9 pr-3 py-2 text-sm" placeholder="Search playlists or videos..."></div></div><div id="sourceList" class="p-2 space-y-1 max-h-64 overflow-y-auto"></div></div></div><label class="text-sm">Title Warehouse<select required name="title_category_id" class="input"><option value="">Select a warehouse</option><% titleCategories.forEach(category => { %><option value="<%= category.id %>" <%= category.titles.length ? '' : 'disabled' %>><%= category.name %> (<%= category.titles.length %> titles)</option><% }) %></select></label></div>
  <div class="relative"><label class="text-sm block">Thumbnail Folder from Gallery <span class="text-gray-500">(all images in the selected folder are used)</span></label><button type="button" onclick="toggleThumbnailSelector()" class="input flex justify-between items-center text-left"><span id="selectedThumbnailFolderText" class="text-gray-400">Choose a Gallery folder...</span><i class="ti ti-chevron-down text-gray-400"></i></button><input required type="hidden" name="thumbnail_video_ids" id="thumbnailVideoIds"><div id="thumbnailSelector" class="hidden absolute z-30 mt-2 w-full bg-dark-700 border border-gray-600 rounded-lg shadow-xl"><div class="p-2 border-b border-gray-600"><div class="relative"><i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i><input id="thumbnailSearch" oninput="renderThumbnailFolderList(this.value)" class="w-full bg-dark-800 border border-gray-700 rounded-lg pl-9 pr-3 py-2 text-sm" placeholder="Search Gallery folders..."></div></div><div id="thumbnailFolderList" class="p-2 space-y-1 max-h-64 overflow-y-auto"></div></div></div>
  <div class="grid md:grid-cols-2 gap-4"><label class="text-sm">Start Time<input required type="time" name="start_time" id="rotationStartTime" onchange="updateDuration()" class="input"></label><div><label class="text-sm block">End Time<input required type="time" name="end_time" id="rotationEndTime" onchange="updateDuration()" class="input"></label><div id="rotationDurationBadge" class="inline-flex mt-2 px-2.5 py-1 rounded bg-primary/15 text-primary text-xs">Duration: 00:00</div></div></div>
  <div class="grid md:grid-cols-2 gap-4"><label class="text-sm">Repeat<select name="repeat_mode" id="repeatMode" onchange="toggleRepeatDays()" class="input"><option value="daily">Every Day</option><option value="weekly">Every Week</option><option value="monthly">Every Month</option></select></label><div id="repeatDays" class="hidden"><span class="text-sm block mb-2">Play on days</span><div class="flex flex-wrap gap-2 text-xs"><% [['0','Sun'],['1','Mon'],['2','Tue'],['3','Wed'],['4','Thu'],['5','Fri'],['6','Sat']].forEach(day => { %><label class="px-2.5 py-1.5 rounded bg-dark-700 border border-gray-600 cursor-pointer hover:border-primary"><input type="checkbox" name="repeat_days" value="<%= day[0] %>" class="mr-1"><%= day[1] %></label><% }) %></div></div></div>
  <label class="text-sm block">Description<textarea name="description" rows="3" class="input"></textarea></label><label class="text-sm block">Tags<textarea name="tags" rows="3" class="input" placeholder="music, live, relaxing, ..."></textarea><span class="text-xs text-gray-500">Separate tags with commas.</span></label><div class="grid md:grid-cols-2 gap-4"><label class="text-sm">Privacy<select name="privacy" class="input"><option value="unlisted">Unlisted</option><option value="public">Public</option><option value="private">Private</option></select></label><label class="text-sm">YouTube Category<select name="category" class="input"><option value="22">People &amp; Blogs</option><option value="20">Gaming</option><option value="24">Entertainment</option><option value="10">Music</option><option value="28">Science &amp; Technology</option><option value="17">Sports</option><option value="27">Education</option></select></label></div><div class="grid md:grid-cols-2 gap-4"><label class="flex items-start gap-2 text-sm p-3 bg-dark-700 rounded border border-gray-600"><input type="checkbox" name="disable_used_titles" value="true" class="mt-0.5"><span><strong>Do not reuse titles</strong><small class="block text-gray-400 mt-1">Used titles are disabled for this rotation.</small></span></label><label class="flex items-start gap-2 text-sm p-3 bg-dark-700 rounded border border-gray-600"><input type="checkbox" name="disable_used_thumbnails" value="true" class="mt-0.5"><span><strong>Do not reuse thumbnails</strong><small class="block text-gray-400 mt-1">Used Gallery images are disabled for this rotation.</small></span></label></div><label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" name="youtube_monetization" value="true"> Enable monetization</label>
</div><div class="p-5 border-t border-gray-700 flex justify-end gap-3"><button type="button" onclick="closeModal('rotationModal')" class="px-4 py-2 text-sm text-gray-300">Cancel</button><button id="rotationSubmitButton" class="px-4 py-2 bg-primary hover:bg-blue-600 rounded-lg text-sm text-white">Save Rotation</button></div></form></div></div>

<div id="rotationViewModal" class="hidden fixed inset-0 z-50 bg-black/70 p-4 overflow-y-auto"><div class="bg-gray-800 max-w-3xl mx-auto my-8 rounded-xl border border-gray-700 shadow-2xl"><div class="flex justify-between items-center p-5 border-b border-gray-700"><div><h3 class="font-semibold text-lg">New Rotation Details</h3><p class="text-xs text-gray-400 mt-1">View-only. Stop the Rotation first if you need to edit it.</p></div><button onclick="closeModal('rotationViewModal')" class="text-gray-400 hover:text-white"><i class="ti ti-x text-xl"></i></button></div><div id="rotationViewContent" class="p-5"></div><div class="p-5 border-t border-gray-700 flex justify-end"><button type="button" onclick="closeModal('rotationViewModal')" class="px-4 py-2 text-sm bg-gray-700 hover:bg-gray-600 rounded-lg">Close</button></div></div></div>

<style>
.input{display:block;width:100%;margin-top:.35rem;padding:.55rem .75rem;background:#1f2937;border:1px solid #4b5563;border-radius:.375rem;color:#fff}.input:focus{outline:none;border-color:#0055ff;box-shadow:0 0 0 1px #0055ff}
.rotation-action-dropdown{position:relative;display:inline-block;vertical-align:middle}.rotation-action-dropdown summary{list-style:none}.rotation-action-dropdown summary::-webkit-details-marker{display:none}.rotation-action-menu,details.relative>div.absolute{position:absolute;top:calc(100% + .35rem);right:0;z-index:60;display:flex;flex-direction:column;gap:.15rem;width:11rem;padding:.25rem;border:1px solid #4b5563;border-radius:.5rem;background:#1f2937;box-shadow:0 12px 24px rgba(0,0,0,.4)}.rotation-action-menu button,details.relative>div.absolute button{display:block;width:100%;white-space:nowrap}
</style>
<% if (typeof preparingRotations !== 'undefined' && preparingRotations.length) { %><script>setTimeout(() => location.reload(), 15000);</script><% } %>
<script>
const csrfToken = '<%= csrfToken %>';
const sourcePlaylists = <%- JSON.stringify(playlists || []) %>;
const sourceVideos = <%- JSON.stringify(sourceVideos || []) %>;
const thumbnailFolders = <%- JSON.stringify(thumbnailFolders || []) %>;
let selectedThumbnailIds = [];
let editingRotationId = null;
let weeklySlots = [];
async function api(url, options = {}) { const response = await fetch(url, {headers:{'Content-Type':'application/json','X-CSRF-Token':csrfToken, ...(options.headers || {})}, ...options}); const data = await response.json(); if (!response.ok || !data.success) throw new Error(data.error || 'Request failed'); return data; }
async function syncMedia(id){try{await api(`/api/new-rotations/${id}/sync-media`,{method:'POST'});location.reload()}catch(error){alert(error.message)}}
async function rebuildReadyMedia(id){if(!confirm('Rebuild Rotation Ready media to 720p / 30 FPS / 4000 Kbps? This uses CPU once.'))return;try{await api(`/api/new-rotations/${id}/rebuild-ready-media`,{method:'POST'});location.reload()}catch(error){alert(error.message)}}
async function viewRotation(id){try{const {rotation}=await api(`/api/new-rotations/${id}`);const sourceId=String(rotation.video_id||''),isPlaylist=sourceId.startsWith('playlist:'),source=isPlaylist?sourcePlaylists.find(item=>`playlist:${item.id}`===sourceId):sourceVideos.find(item=>item.id===sourceId),category=(<%- JSON.stringify(titleCategories || []) %>).find(item=>item.id===rotation.title_category_id),channel=(<%- JSON.stringify(youtubeChannels || []) %>).find(item=>item.id===rotation.youtube_channel_id),folderId=rotation.thumbnails?.[0]?.folder_id,folder=thumbnailFolders.find(item=>item.id===folderId),days=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'],repeat=rotation.repeat_mode==='weekly'?`Every Week · ${String(rotation.repeat_days||'').split(',').map(Number).filter(Number.isInteger).map(day=>days[day]).filter(Boolean).join(', ')||'No days selected'}`:rotation.repeat_mode==='monthly'?'Every Month':'Every Day',time=value=>String(value||'').includes('T')?value.split('T')[1].slice(0,5):'--',sourceLabel=isPlaylist?`Playlist: ${source?.name||sourceId.slice(9)}`:(source?.title||sourceId),thumbLabel=folder?`${folder.name} (${rotation.thumbnails?.length||0} images)`:`${rotation.thumbnails?.length||0} images`,yesNo=value=>value?'Yes':'No';document.getElementById('rotationViewContent').innerHTML=`<div class="grid md:grid-cols-2 gap-4 text-sm"><div class="bg-dark-700 rounded-lg p-4"><div class="text-xs text-gray-400">Rotation Name</div><div class="font-medium mt-1">${escapeHtml(rotation.name)}</div></div><div class="bg-dark-700 rounded-lg p-4"><div class="text-xs text-gray-400">Status</div><div class="font-medium mt-1 capitalize">${escapeHtml(rotation.status||'inactive')}</div><div class="text-xs text-gray-400 mt-1">${rotation.live_count||0} kali live · Media: ${escapeHtml(rotation.preparation_status||'--')}</div></div><div class="bg-dark-700 rounded-lg p-4"><div class="text-xs text-gray-400">Source Video / Playlist</div><div class="font-medium mt-1 break-words">${escapeHtm