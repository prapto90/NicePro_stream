<% layout('layout') -%>

<div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
  <div>
    <a href="/new-rotations" class="inline-flex items-center gap-1 text-sm text-primary hover:text-blue-300"><i class="ti ti-arrow-left"></i> New Rotations</a>
    <h2 class="text-2xl font-bold mt-2">Title Warehouse</h2>
    <p class="text-gray-400 text-sm mt-1">Create categories for channels, then add many rotation titles at once.</p>
  </div>
  <a href="/new-rotations" class="inline-flex justify-center items-center gap-2 px-4 py-2 rounded-lg bg-primary hover:bg-blue-600 text-white"><i class="ti ti-repeat"></i> View New Rotations</a>
</div>

<div class="bg-gray-800 border border-gray-700 rounded-xl p-5 mb-6">
  <h3 class="font-semibold">Add Title Category</h3>
  <p class="text-xs text-gray-400 mt-1">Use a category to group titles for each YouTube channel.</p>
  <form id="categoryForm" class="mt-4 flex flex-col sm:flex-row gap-3">
    <input id="categoryName" required class="input flex-1" placeholder="Example: Afrika Music Channel">
    <button class="px-4 py-2 bg-primary hover:bg-blue-600 rounded-lg text-white whitespace-nowrap"><i class="ti ti-plus mr-1"></i> Add Category</button>
  </form>
</div>

<% if (titleCategories.length) { %>
<div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
  <% titleCategories.forEach(category => { %>
  <section class="bg-gray-800 border border-gray-700 rounded-xl overflow-hidden">
    <div class="p-5 border-b border-gray-700 flex items-start justify-between gap-4">
      <div><h3 class="font-semibold text-lg"><%= category.name %></h3><p class="text-xs text-gray-400 mt-1"><%= category.titles.length %> titles available for New Rotations</p></div>
      <button onclick="deleteCategory('<%= category.id %>')" class="text-xs px-3 py-1.5 border border-red-500/40 text-red-300 rounded-lg hover:bg-red-500/15">Delete</button>
    </div>
    <div class="p-5">
      <label class="text-sm font-medium">Add Titles</label>
      <textarea id="bulkTitles-<%= category.id %>" rows="5" class="input" placeholder="Love Afrika&#10;Relaxing Afrika&#10;Romantis Afrika"></textarea>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mt-3"><span class="text-xs text-gray-500">Separate each title with a new line or comma.</span><button onclick="addTitles('<%= category.id %>')" class="px-4 py-2 text-sm bg-primary hover:bg-blue-600 rounded-lg text-white"><i class="ti ti-plus mr-1"></i> Add Titles</button></div>
      <div class="mt-5 border-t border-gray-700 pt-4"><div class="flex items-center justify-between mb-2"><span class="text-xs uppercase tracking-wide text-gray-400">Saved Titles</span><span class="text-xs text-gray-500"><%= category.titles.length %> total</span></div>
        <div class="max-h-72 overflow-y-auto space-y-1 pr-1">
          <% category.titles.forEach(title => { %><div class="flex items-center justify-between gap-3 px-3 py-2 bg-dark-700 rounded-lg text-sm"><div class="min-w-0 flex items-center gap-2"><span class="break-words"><%= title.title %></span><% if (title.used_live) { %><span class="flex-shrink-0 text-[10px] px-1.5 py-0.5 rounded bg-green-500/15 text-green-400">Used Live</span><% } %></div><button onclick="deleteTitle('<%= title.id %>')" class="text-gray-500 hover:text-red-400 flex-shrink-0" title="Delete title"><i class="ti ti-x"></i></button></div><% }) %>
          <% if (!category.titles.length) { %><p class="text-sm text-gray-500 text-center py-5">No titles yet. Add titles above.</p><% } %>
        </div>
      </div>
    </div>
  </section>
  <% }) %>
</div>
<% } else { %>
<div class="bg-gray-800 border border-gray-700 rounded-xl p-10 text-center"><i class="ti ti-folder-plus text-4xl text-primary"></i><h3 class="font-semibold mt-3">No title categories yet</h3><p class="text-sm text-gray-400 mt-1">Create a category above to start storing rotation titles.</p></div>
<% } %>

<style>.input{display:block;width:100%;margin-top:.35rem;padding:.55rem .75rem;background:#1f2937;border:1px solid #4b5563;border-radius:.375rem;color:#fff}.input:focus{outline:none;border-color:#0055ff;box-shadow:0 0 0 1px #0055ff}</style>
<script>
const csrfToken = '<%= csrfToken %>';
async function api(url, options = {}) { const response = await fetch(url, { headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken, ...(options.headers || {}) }, ...options }); const data = await response.json(); if (!response.ok || !data.success) throw new Error(data.error || 'Request failed'); return data; }
document.getElementById('categoryForm').addEventListener('submit', async event => { event.preventDefault(); const input = document.getElementById('categoryName'); try { await api('/api/new-rotations/categories', { method: 'POST', body: JSON.stringify({ name: input.value }) }); location.reload(); } catch (error) { alert(error.message); } });
async function addTitles(id) { const input = document.getElementById(`bulkTitles-${id}`); if (!input.value.trim()) return; try { await api(`/api/new-rotations/categories/${id}/titles`, { method: 'POST', body: JSON.stringify({ titles: input.value }) }); location.reload(); } catch (error) { alert(error.message); } }
async function deleteTitle(id) { if (!confirm('Delete this title?')) return; try { await api(`/api/new-rotations/titles/${id}`, { method: 'DELETE' }); location.reload(); } catch (error) { alert(error.message); } }
async function deleteCategory(id) { if (!confirm('Delete this unused category and all of its titles?')) return; try { await api(`/api/new-rotations/categories/${id}`, { method: 'DELETE' }); location.reload(); } catch (error) { alert(error.message); } }
</script>
